{
	"manifest_version": 3,
	"name": "Tabius - Automatic Tab Grouping Assistant",
	"short_name": "Tabius",
	"description": "An Automatic Tab Grouping Extension for Your Browser.",
	"version": "2.0.7",
	"author": "Faisal Ahmed",
	"background": {
		"service_worker": "assets/background.js",
		"type": "module"
	},
	"icons": {
		"128": "/icon.png"
	},
	"content_scripts": [],
	"action": {
		"default_title": "Tab Groups",
		"default_popup": "src/action.html"
	},
	"options_ui": {
		"page": "src/options/options.html",
		"open_in_tab": true
	},
	"commands": {
		"quick-switch": {
			"suggested_key": {
				"default": "Alt+Q",
				"mac": "Alt+Q"
			},
			"description": "Switch to the previously used tab (press again quickly to go further back)"
		}
	},
	"permissions": ["tabs", "tabGroups", "storage", "contextMenus", "webNavigation"]
}
